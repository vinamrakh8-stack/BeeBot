# ---------------------------------------------------------------------------
# Bee Voice+ — copy to `.env` and fill in. No real secrets belong in this file.
# ---------------------------------------------------------------------------

APP_ENV=development

# Random 32+ byte string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=q8HVgX0AD2vz3y_Xu9ziBqDztDLvZNAkV0ZPw0SJxi0Onz3O6Ve6KnzZyUOfI-9_

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# SQLite works out of the box. For MySQL 8, comment out the SQLite line and use
# the example below.
DATABASE_URL=sqlite:///./bee_voice.db
# DATABASE_URL=mysql+pymysql://bee:change-me@127.0.0.1:3306/bee_voice?charset=utf8mb4

# --- dashboard operator account (this app, not Bee) ------------------------
APP_USERNAME=operator
# bcrypt hash, never a plaintext password. Generate with:
#   python app.py hash-password
APP_PASSWORD_HASH=replace-me-with-a-bcrypt-hash

# Development-only demo account shown on the sign-in page. Set
# DEMO_LOGIN_ENABLED=false to hide it; it is never exposed in production.
DEMO_LOGIN_ENABLED=true
DEMO_PASSWORD=123456

# --- Bee developer API -----------------------------------------------------
# token -> public HTTPS endpoint with a Bearer token (default)
# proxy -> local `bee proxy` on 127.0.0.1, no Authorization header
BEE_API_MODE=token
BEE_API_BASE_URL=https://api.developer.bee.amazon.dev
BEE_PROXY_URL=http://127.0.0.1:8787

# Only for token mode. Obtain via `bee login` / `bee status` (see README).
BEE_TOKEN=

# Bee rejects incremental cursors older than 7 days, so sync at least daily.
BEE_TIMEOUT_SECONDS=20
BEE_MAX_RETRIES=4
BEE_SYNC_PAGE_SIZE=50
BEE_SYNC_MAX_PAGES=40

# Development fixtures are disabled by default and are rejected outright when
# APP_ENV=production. Leave false to talk to your real Bee account only.
BEE_ALLOW_MOCK=false

# --- AI provider (optional; server-side only) ------------------------------
# OpenAI-compatible HTTP API. Neither the browser nor the phone receives this
# key. Without a key (or a local keyless endpoint), AI/chat/voice/meeting/learning
# generation returns HTTP 503 `ai_not_configured`; deterministic features still
# work. Set AI_PROVIDER=disabled to turn every AI call off even if a key is present.
# This setting does not affect Bee sync, local CRUD, insights, or the graph.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2

# Optional server-side speech fallbacks. The website uses browser speech APIs
# first; the mobile companion sends its question recording to this server.
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# Per-operator AI request limit and retrieval bounds. Retrieval is keyword-only
# in this configuration; no embedding provider or vector store is configured.
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONTEXT_SOURCES=8
AI_MAX_AUDIO_BYTES=10485760

# Website wake word stays disabled: no local engine is bundled and continuous
# cloud audio detection is intentionally not used. The phone companion can opt
# into an operating-system on-device wake word; it never uses Bee for this.
WAKE_WORD_PHRASE=Hey Bee
WAKE_WORD_ENGINE=disabled

# --- mobile companion pairing (Phase 3) ------------------------------------
# Paired phones receive an opaque bearer token. Only its SHA-256 hash is stored
# in mobile_tokens. The raw token is shown once and kept in the phone's
# Keychain/Keystore. Adjust the lifetime and pairing attempts per minute here.
MOBILE_TOKEN_TTL_DAYS=90
MOBILE_PAIR_RATE_LIMIT_PER_MINUTE=5

# For a local OpenAI-compatible server (Ollama, LM Studio, llama.cpp), set the
# base URL to localhost and leave AI_API_KEY empty; public hosts require a key.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2

# --- server ----------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Signed-cookie session name and lifetime (hours, default 7 days).
SESSION_COOKIE_NAME=bee_session
SESSION_TTL_HOURS=168
# Built React app served by app.py (relative to backend/).
FRONTEND_DIST=../frontend/dist
