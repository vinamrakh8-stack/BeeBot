    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^25.0.1",
    "typescript": "5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
